        async function tryConnectDatabase(url, secret, isPreset = false) {
            let cleanUrl = url.trim();
            if (!cleanUrl.startsWith('http://') && !cleanUrl.startsWith('https://')) {
                cleanUrl = 'https://' + cleanUrl;
            }
            if (!cleanUrl.endsWith('/')) {
                cleanUrl += '/';
            }

            Swal.fire({
                title: '실시간 DB 보안 접속 중',
                text: `${cleanUrl} 연결 권한 획득 중...`,
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {
                const checkUrl = `${cleanUrl}.json` + (secret ? `?auth=${secret}` : '');
                
                const response = await fetch(checkUrl).catch(err => {
                    return { ok: false, status: 'NetworkError', statusText: err.message };
                });
                
                if (!response.ok) {
                    handleConnectionFailure(cleanUrl, response.status || '404');
                    return;
                }

                currentDbUrl = cleanUrl;
                currentDbSecret = secret;

                if (!authSession) {
                    authSession = {
                        name: "수동 개발자님",
                        provider: "Custom RTDB",
                        isSimulator: false
                    };
                }

                updateUserProfileUI();
                document.getElementById('auth-gate').classList.add('opacity-0', 'pointer-events-none');
                
                syncDatabasePreview();
                appendConsoleLog("auth", `✔ 원격 실시간 데이터베이스 연결 수립 완료: ${cleanUrl}`);

                Swal.fire({
                    icon: 'success',
                    title: '연결 성공!',
                    text: '파이어베이스 데이터베이스가 완벽하게 바인딩되었습니다.',
                    timer: 1500,
                    showConfirmButton: false
                });

            } catch (error) {
                handleConnectionFailure(cleanUrl, error.message);
            }
        }

