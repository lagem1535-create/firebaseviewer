        // {경로} 포맷을 찾아 실제 데이터베이스 내부의 값을 실시간으로 읽어와 치환해 주는 유틸리티
        async function parseDynamicPrompt(promptText) {
            if (!promptText) return "";
            const regex = /\{([^}]+)\}/g;
            let parsed = promptText;
            let match;
            while ((match = regex.exec(promptText)) !== null) {
                const path = match[1];
                try {
                    const val = await apiGet(path);
                    const valStr = val !== null ? (typeof val === 'object' ? JSON.stringify(val) : String(val)) : "";
                    parsed = parsed.replace(`{${path}}`, valStr);
                } catch (e) {
                    parsed = parsed.replace(`{${path}}`, `[Error: ${path}]`);
                }
            }
            return parsed;
        }

        // Base64를 ArrayBuffer로 바꾸는 헬퍼
        function decodeBase64ToArrayBuffer(base64) {
            const binaryString = atob(base64);
            const len = binaryString.length;
            const bytes = new Uint8Array(len);
            for (let i = 0; i < len; i++) {
                bytes[i] = binaryString.charCodeAt(i);
            }
            return bytes.buffer;
        }

        // PCM 16bit을 WAV 포맷 블롭 파일로 변환
        function pcmToWav(samples, sampleRate) {
            const buffer = new ArrayBuffer(44 + samples.length * 2);
            const view = new DataView(buffer);

            writeString(view, 0, 'RIFF');
            view.setUint32(4, 36 + samples.length * 2, true);
            writeString(view, 8, 'WAVE');
            writeString(view, 12, 'fmt ');
            view.setUint32(16, 16, true);
            view.setUint16(20, 1, true);
            view.setUint16(22, 1, true);
            view.setUint32(24, sampleRate, true);
            view.setUint32(28, sampleRate * 2, true);
            view.setUint16(32, 2, true);
            view.setUint16(34, 16, true);
            writeString(view, 36, 'data');
            view.setUint32(40, samples.length * 2, true);

            for (let i = 0; i < samples.length; i++) {
                view.setInt16(44 + i * 2, samples[i], true);
            }

            return new Blob([view], { type: 'audio/wav' });
        }

        function writeString(view, offset, string) {
            for (let i = 0; i < string.length; i++) {
                view.setUint8(offset + i, string.charCodeAt(i));
            }
        }

