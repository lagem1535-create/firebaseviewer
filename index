        function addBlockToWorkspace(type) {
            const template = PAL_BLOCK_TEMPLATES[type];
            if (!template) return;

            const inputsClone = template.inputs ? template.inputs.map(inp => ({ ...inp })) : [];
            const blockId = "block_" + Date.now() + "_" + Math.floor(Math.random() * 1000);

            const newBlock = {
                id: blockId,
                type: type,
                title: template.title,
                icon: template.icon,
                color: template.color,
                btnColor: template.btnColor,
                inputs: inputsClone
            };

            activeBlocks.push(newBlock);
            renderWorkspaceCanvas();
            showToast('블록 추가됨', `${template.title}이 캔버스 하단에 조립되었습니다.`, 'success');
        }

        function renderWorkspaceCanvas() {
            const canvas = document.getElementById('workspace-canvas');
            const emptyState = document.getElementById('canvas-empty-state');

            if (activeBlocks.length === 0) {
                emptyState.classList.remove('hidden');
                const blocks = canvas.querySelectorAll('.canvas-block-instance');
                blocks.forEach(b => b.remove());
                return;
            } else {
                emptyState.classList.add('hidden');
                const blocks = canvas.querySelectorAll('.canvas-block-instance');
                blocks.forEach(b => b.remove());
            }

            activeBlocks.forEach((block, index) => {
                const blockEl = document.createElement('div');
                blockEl.className = `canvas-block-instance bg-white border border-slate-200 p-4 rounded-2xl shadow-sm flex flex-col md:flex-row items-start md:items-center gap-4 relative group transition-all duration-200 animate-fade-in border-l-4`;
                
                const bType = block.type || '';

                // 각 블록 그룹 고유 장식 보더 색상 매핑
                if (bType.startsWith('GEMINI_')) {
                    blockEl.classList.add('border-l-indigo-500');
                } else if (bType === 'SET' || bType === 'UPDATE' || bType === 'PUSH' || bType === 'INCREMENT' || bType === 'TIMESTAMP') {
                    blockEl.classList.add('border-l-blue-500');
                } else if (bType === 'GET' || bType.startsWith('IF_') || bType === 'LOGIC_COMPARE') {
                    blockEl.classList.add('border-l-amber-500');
                } else if (bType === 'DELETE' || bType === 'CLEAR_PATH' || bType === 'COPY_NODE') {
                    blockEl.classList.add('border-l-rose-500');
                } else if (bType.startsWith('MATH_') || bType.startsWith('TEXT_')) {
                    blockEl.classList.add('border-l-cyan-500');
                } else if (bType.startsWith('ARRAY_')) {
                    blockEl.classList.add('border-l-fuchsia-500');
                } else if (bType.startsWith('FILE_') || bType.startsWith('WEB_')) {
                    blockEl.classList.add('border-l-emerald-500');
                } else {
                    blockEl.classList.add('border-l-slate-400');
                }

                blockEl.setAttribute('id', block.id);

                const controlCol = document.createElement('div');
                controlCol.className = "flex items-center gap-1.5 shrink-0 select-none";
                controlCol.innerHTML = `
                    <div class="flex flex-col gap-0.5 items-center">
                        <button onclick="moveBlock(${index}, 'up')" class="p-1 hover:bg-slate-100 rounded text-slate-400 hover:text-slate-700 transition-all" title="위로 이동">
                            <i data-lucide="chevron-up" class="w-4 h-4"></i>
                        </button>
                        <button onclick="moveBlock(${index}, 'down')" class="p-1 hover:bg-slate-100 rounded text-slate-400 hover:text-slate-700 transition-all" title="아래로 이동">
                            <i data-lucide="chevron-down" class="w-4 h-4"></i>
                        </button>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-slate-300 font-mono text-[10px]">${index + 1}</span>
                        <i data-lucide="${block.icon}" class="w-4.5 h-4.5 text-slate-700"></i>
                        <span class="text-xs font-bold text-slate-800">${block.title}</span>
                    </div>
                `;
                blockEl.appendChild(controlCol);

                // 입력 필드 목록 생성
                const inputsCol = document.createElement('div');
                inputsCol.className = "flex-1 flex flex-wrap gap-2.5 items-center w-full";

                // Defend against missing inputs arrays safely
                const blockInputs = block.inputs || [];
                blockInputs.forEach((input) => {
                    const inputFieldWrapper = document.createElement('div');
                    inputFieldWrapper.className = "flex items-center gap-1 bg-slate-50 border border-slate-200 px-2.5 py-1 rounded-xl w-full md:w-auto";
                    
                    const labelSpan = document.createElement('span');
                    labelSpan.className = "text-[10px] font-bold text-slate-400 uppercase shrink-0";
                    labelSpan.innerText = input.label;

                    let editableElement;
                    if (input.type === 'select') {
                        editableElement = document.createElement('select');
                        editableElement.className = "bg-transparent text-xs text-slate-700 font-bold outline-none cursor-pointer p-0 border-0";
                        input.options.forEach(opt => {
                            const option = document.createElement('option');
                            option.value = opt;
                            option.text = opt;
                            option.className = "text-slate-800";
                            if (opt === input.value) option.selected = true;
                            editableElement.appendChild(option);
                        });
                        editableElement.onchange = (e) => {
                            input.value = e.target.value;
                        };
                    } else {
                        editableElement = document.createElement('input');
                        editableElement.type = 'text';
                        editableElement.className = "bg-transparent text-xs text-slate-700 outline-none font-semibold placeholder:text-slate-300 w-full md:w-28 focus:bg-white rounded px-1 transition-all border-0 p-0";
                        editableElement.placeholder = input.placeholder || '';
                        editableElement.value = input.value || '';
                        editableElement.oninput = (e) => {
                            input.value = e.target.value;
                        };
                    }

                    inputFieldWrapper.appendChild(labelSpan);
                    inputFieldWrapper.appendChild(editableElement);
                    inputsCol.appendChild(inputFieldWrapper);
                });
                blockEl.appendChild(inputsCol);

                // 우측 끝 삭제 버튼 생성
                const deleteCol = document.createElement('div');
                deleteCol.className = "shrink-0 ml-auto flex items-center";
                deleteCol.innerHTML = `
                    <button onclick="removeBlockFromWorkspace('${block.id}')" class="p-1.5 bg-slate-50 hover:bg-rose-50 text-slate-400 hover:text-rose-600 rounded-xl transition-all" title="블록 삭제">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                `;
                blockEl.appendChild(deleteCol);

                canvas.appendChild(blockEl);
            });

            lucide.createIcons();
        }

        function moveBlock(index, direction) {
            if (direction === 'up' && index > 0) {
                const temp = activeBlocks[index];
                activeBlocks[index] = activeBlocks[index - 1];
                activeBlocks[index - 1] = temp;
            } else if (direction === 'down' && index < activeBlocks.length - 1) {
                const temp = activeBlocks[index];
                activeBlocks[index] = activeBlocks[index + 1];
                activeBlocks[index + 1] = temp;
            }
            renderWorkspaceCanvas();
        }

        function removeBlockFromWorkspace(id) {
            activeBlocks = activeBlocks.filter(b => b.id !== id);
            renderWorkspaceCanvas();
            showToast("블록 삭제", "조립판에서 성공적으로 블록이 제거되었습니다.", "info");
        }

        function clearWorkspace() {
            if (activeBlocks.length === 0) return;
            Swal.fire({
                title: '조립판 비우기',
                text: '현재 기입 중인 모든 블록들을 초기화하시겠습니까?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                confirmButtonText: '네, 비웁니다',
                cancelButtonText: '취소'
            }).then((res) => {
                if (res.isConfirmed) {
                    activeBlocks = [];
                    renderWorkspaceCanvas();
                    showToast("초기화 완료", "캔버스가 완벽히 정리되었습니다.", "success");
                }
            });
        }

        async function executeBlockProgram() {
            if (activeBlocks.length === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: '컴파일 불가',
                    text: '조립판에 구성된 실행 활성 블록이 존재하지 않습니다.'
                });
                return;
            }

            appendConsoleLog("compile", "▶ 블록 프로그램 조립본 해석 및 컴파일 실행 시작...");
            let successCount = 0;
            let failCount = 0;

            for (let i = 0; i < activeBlocks.length; i++) {
                const block = activeBlocks[i];
                const blockDOM = document.getElementById(block.id);
                if (blockDOM) blockDOM.classList.add('block-running');

                await new Promise(resolve => setTimeout(resolve, 400));

                const inputsMap = {};
                // Defend against missing inputs safely
                const blockInputs = block.inputs || [];
                blockInputs.forEach(inp => {
                    inputsMap[inp.key] = inp.value ? inp.value.trim() : '';
                });

                try {
                    const bType = block.type || '';

                    // [인공지능 & Gemini API 연동 블록 실행 핵심 로직]
                    if (bType === 'GEMINI_TEXT_GEN') {
                        const rawPrompt = inputsMap.prompt;
                        if (!rawPrompt) throw new Error("프롬프트 템플릿 대사가 비어있습니다.");
                        const finalPrompt = await parseDynamicPrompt(rawPrompt);
                        const systemInstruction = inputsMap.system || "친절한 AI 어시스턴트";
                        
                        appendConsoleLog("system", `🤖 [Gemini LLM 요청] 프롬프트 파싱 결과: "${finalPrompt}"`);
                        
                        const apiKey = "";
                        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
                        const payload = {
                            contents: [{ parts: [{ text: finalPrompt }] }],
                            systemInstruction: {
                                parts: [{ text: systemInstruction }]
                            }
                        };
                        
                        const response = await fetch(apiUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        
                        if (!response.ok) throw new Error(`Gemini LLM 통신 응답 실패 (상태: ${response.status})`);
                        const result = await response.json();
                        const responseText = result.candidates?.[0]?.content?.parts?.[0]?.text || "결과 없음";
                        
                        const targetPath = inputsMap.path || "ai_output/text";
                        await apiPut(targetPath, responseText);
                        appendConsoleLog("response", `[성공] AI 생성 답변을 /${targetPath} 경로에 저장 완료.`);
                        successCount++;

                    } else if (bType === 'GEMINI_IMAGE_GEN') {
                        const rawPrompt = inputsMap.prompt;
                        if (!rawPrompt) throw new Error("그림 생성 프롬프트가 비어있습니다.");
                        const finalPrompt = await parseDynamicPrompt(rawPrompt);
                        
                        appendConsoleLog("system", `🎨 [Imagen 묘사 요청] 프롬프트 파싱 결과: "${finalPrompt}"`);
                        
                        const apiKey = "";
                        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/imagen-4.0-generate-001:predict?key=${apiKey}`;
                        const payload = {
                            instances: [{ prompt: finalPrompt }],
                            parameters: { 
                                sampleCount: 1,
                                aspectRatio: inputsMap.property || "1:1"
                            }
                        };
                        
                        const response = await fetch(apiUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        
                        if (!response.ok) throw new Error(`Imagen API 통신 실패 (상태: ${response.status})`);
                        const result = await response.json();
                        const base64Data = result.predictions?.[0]?.bytesBase64Encoded;
                        if (!base64Data) throw new Error("인공지능 모델이 이미지 바이트 생성을 거부했습니다.");
                        
                        const imageUrl = `data:image/png;base64,${base64Data}`;
                        const targetPath = inputsMap.path || "ai_output/image_base64";
                        await apiPut(targetPath, imageUrl);
                        appendConsoleLog("response", `[성공] AI 렌더링 결과 그래픽 데이터를 /${targetPath} 에 저장했습니다.`);
                        successCount++;

                    } else if (bType === 'GEMINI_TTS_GEN') {
                        const rawPrompt = inputsMap.prompt;
                        if (!rawPrompt) throw new Error("TTS로 낭독할 대사 텍스트가 비어있습니다.");
                        const finalPrompt = await parseDynamicPrompt(rawPrompt);
                        
                        appendConsoleLog("system", `🗣 [Gemini TTS 합성 요청] 파싱 텍스트: "${finalPrompt}"`);
                        
                        const voiceMap = {
                            'Zephyr (밝음)': 'Zephyr',
                            'Puck (경쾌)': 'Puck',
                            'Kore (차분)': 'Kore',
                            'Fenrir (신남)': 'Fenrir',
                            'Leda (차분)': 'Leda'
                        };
                        const voiceName = voiceMap[inputsMap.property] || 'Zephyr';

                        const payload = {
                            contents: [{
                                parts: [{ text: finalPrompt }]
                            }],
                            generationConfig: {
                                responseModalities: ["AUDIO"],
                                speechConfig: {
                                    voiceConfig: {
                                        prebuiltVoiceConfig: { voiceName: voiceName }
                                    }
                                }
                            },
                            model: "gemini-2.5-flash-preview-tts"
                        };
                        
                        const apiKey = "";
                        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-tts:generateContent?key=${apiKey}`;
                        const response = await fetch(apiUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        
                        if (!response.ok) throw new Error(`TTS API 통신 오류 (상태: ${response.status})`);
                        const result = await response.json();
                        const part = result?.candidates?.[0]?.content?.parts?.[0];
                        const audioData = part?.inlineData?.data;
                        const mimeType = part?.inlineData?.mimeType;

                        if (audioData && mimeType && mimeType.startsWith("audio/")) {
                            const sampleRateMatch = mimeType.match(/rate=(\d+)/);
                            const sampleRate = sampleRateMatch ? parseInt(sampleRateMatch[1], 10) : 24000;
                            
                            const rawBytes = decodeBase64ToArrayBuffer(audioData);
                            const pcm16 = new Int16Array(rawBytes);
                            const wavBlob = pcmToWav(pcm16, sampleRate);
                            const audioUrl = URL.createObjectURL(wavBlob);
                            
                            const audio = new Audio(audioUrl);
                            audio.play();
                            appendConsoleLog("response", `🔊 [TTS 플레이] "${finalPrompt}" 자연 음성 낭독을 시작합니다.`);
                        } else {
                            throw new Error("올바른 오디오 바이너리 스트림이 반환되지 않았습니다.");
                        }
                        successCount++;

                    // 데이터베이스 쓰기
                    } else if (bType === 'SET') {
                        if (!inputsMap.property) throw new Error("Key(속성 이름)이 기입되지 않았습니다.");
                        let finalValue = inputsMap.value;
                        if (finalValue === 'true') finalValue = true;
                        else if (finalValue === 'false') finalValue = false;
                        else if (!isNaN(finalValue) && finalValue !== "") finalValue = Number(finalValue);

                        const targetPath = inputsMap.path ? `${inputsMap.path}/${inputsMap.property}` : inputsMap.property;
                        await apiPut(targetPath, finalValue);
                        appendConsoleLog("response", `[성공] /${targetPath} 경로에 "${finalValue}" 값을 덮어썼습니다.`);
                        successCount++;

                    } else if (bType === 'UPDATE') {
                        if (!inputsMap.property) throw new Error("수정할 Key 이름이 정의되지 않았습니다.");
                        let finalValue = inputsMap.value;
                        if (finalValue === 'true') finalValue = true;
                        else if (finalValue === 'false') finalValue = false;
                        else if (!isNaN(finalValue) && finalValue !== "") finalValue = Number(finalValue);

                        const targetPath = inputsMap.path ? `${inputsMap.path}/${inputsMap.property}` : inputsMap.property;
                        await apiPut(targetPath, finalValue);
                        appendConsoleLog("response", `[성공] /${targetPath} 경로의 값을 "${finalValue}"(으)로 부분 수정했습니다.`);
                        successCount++;

                    } else if (bType === 'PUSH') {
                        if (!inputsMap.value) throw new Error("PUSH할 값 내용이 비어있습니다.");
                        const generatedId = await apiPush(inputsMap.path || "/", inputsMap.value);
                        appendConsoleLog("response", `[성공] /${inputsMap.path || 'root'} 하위에 고유 ID [${generatedId}] 생성 후 데이터 삽입 완료.`);
                        successCount++;

                    } else if (bType === 'INCREMENT') {
                        if (!inputsMap.property) throw new Error("대상 속성 Key가 기입되지 않았습니다.");
                        const targetPath = inputsMap.path ? `${inputsMap.path}/${inputsMap.property}` : inputsMap.property;
                        const currentVal = Number(await apiGet(targetPath)) || 0;
                        const finalVal = currentVal + 1;
                        await apiPut(targetPath, finalVal);
                        appendConsoleLog("response", `[성공] /${targetPath} 경로의 숫자를 1 증가시켰습니다. (${currentVal} -> ${finalVal})`);
                        successCount++;

                    } else if (bType === 'TIMESTAMP') {
                        if (!inputsMap.property) throw new Error("시간을 기록할 속성 Key 이름이 필요합니다.");
                        const targetPath = inputsMap.path ? `${inputsMap.path}/${inputsMap.property}` : inputsMap.property;
                        const nowTime = new Date().toISOString();
                        await apiPut(targetPath, nowTime);
                        appendConsoleLog("response", `[성공] /${targetPath}에 현재 시간 정보[${nowTime}]를 기입했습니다.`);
                        successCount++;

                    // 데이터베이스 읽기 및 조건
                    } else if (bType === 'GET') {
                        const targetPath = inputsMap.path ? `${inputsMap.path}/${inputsMap.property}` : inputsMap.property;
                        const dbVal = await apiGet(targetPath);
                        appendConsoleLog("response", `[조회 결과] /${targetPath} 에 있는 값은 -> [${dbVal === null ? 'null(존재 안 함)' : JSON.stringify(dbVal)}] 입니다.`);
                        successCount++;

                    } else if (bType === 'IF_EQUAL') {
                        const targetPath = inputsMap.path ? `${inputsMap.path}/${inputsMap.property}` : inputsMap.property;
                        const dbVal = await apiGet(targetPath);
                        const isMatch = String(dbVal) === inputsMap.value;
                        appendConsoleLog("system", `[조건 비교] 실제 DB 값: "${dbVal}" vs 비교 대상 값: "${inputsMap.value}"`);
                        
                        if (isMatch) {
                            appendConsoleLog("response", `🔔 [조건 충족] 만족 동작 실행 -> [${inputsMap.action}]`);
                            if (inputsMap.action === '데이터 전체 삭제하기') {
                                if (inputsMap.path) {
                                    await apiDelete(inputsMap.path);
                                    appendConsoleLog("response", `💥 /${inputsMap.path} 하위 데이터가 완전히 제거되었습니다.`);
                                } else {
                                    throw new Error("안전을 위해 루트 전체 삭제 동작은 차단되었습니다.");
                                }
                            } else {
                                appendConsoleLog("response", `💬 알림 로그: "조건 만족 조건문 연산 결과 참(True)이 감지되었습니다."`);
                            }
                        } else {
                            appendConsoleLog("system", `❌ [조건 불일치] 비교 판단 결과가 성립하지 않아 내부 하위 동작이 무시되었습니다.`);
                        }
                        successCount++;

                    } else if (bType === 'IF_GREATER') {
                        const targetPath = inputsMap.path ? `${inputsMap.path}/${inputsMap.property}` : inputsMap.property;
                        const dbVal = Number(await apiGet(targetPath)) || 0;
                        const threshold = Number(inputsMap.value) || 0;
                        
                        if (dbVal > threshold) {
                            appendConsoleLog("response", `🔔 [조건 초과 성공] 실제 값(${dbVal})이 기준값(${threshold})보다 큽니다!`);
                        } else {
                            appendConsoleLog("system", `❌ [조건 불성립] 실제 값(${dbVal})이 기준값(${threshold}) 이하입니다.`);
                        }
                        successCount++;

                    } else if (bType === 'IF_EXISTS') {
                        const dbVal = await apiGet(inputsMap.path || "/");
                        if (dbVal !== null) {
                            appendConsoleLog("response", `🔔 [노드 감지 성공] /${inputsMap.path} 데이터가 정상적으로 존재합니다.`);
                        } else {
                            appendConsoleLog("system", `❌ [노드 감지 실패] /${inputsMap.path} 데이터가 감지되지 않았습니다 (null).`);
                        }
                        successCount++;

                    } else if (bType === 'LOGIC_COMPARE') {
                        if (!inputsMap.path) throw new Error("비교 대상 변수 1의 데이터 경로가 없습니다.");
                        const val1 = await apiGet(inputsMap.path);
                        const val2 = isNaN(inputsMap.value) ? inputsMap.value : Number(inputsMap.value);
                        const op = inputsMap.property || '==';
                        let logicResult = false;
                        
                        const numVal1 = isNaN(val1) ? val1 : Number(val1);
                        
                        if (op === '>') logicResult = numVal1 > val2;
                        else if (op === '<') logicResult = numVal1 < val2;
                        else if (op === '==') logicResult = String(numVal1) === String(val2);
                        else if (op === '!=') logicResult = String(numVal1) !== String(val2);
                        else if (op === '>=') logicResult = numVal1 >= val2;
                        else if (op === '<=') logicResult = numVal1 <= val2;

                        if (logicResult) {
                            appendConsoleLog("response", `🔔 [논리 비교 성립] ${val1} ${op} ${val2} 판정: 참(True) 입니다.`);
                        } else {
                            appendConsoleLog("system", `❌ [논리 비교 실패] ${val1} ${op} ${val2} 판정: 거짓(False) 입니다.`);
                        }
                        successCount++;

                    // 데이터베이스 제어
                    } else if (bType === 'DELETE') {
                        const targetPath = inputsMap.property ? `${inputsMap.path}/${inputsMap.property}` : inputsMap.path;
                        if (!targetPath) throw new Error("삭제할 대상 데이터 경로를 채워주세요.");
                        await apiDelete(targetPath);
                        appendConsoleLog("response", `[성공] /${targetPath} 경로 및 하위 트리 제거 완료.`);
                        successCount++;

                    } else if (bType === 'CLEAR_PATH') {
                        if (!inputsMap.path) throw new Error("초기화할 폴더 경로를 지정하세요.");
                        await apiPut(inputsMap.path, {});
                        appendConsoleLog("response", `[성공] /${inputsMap.path} 하위 데이터를 완전히 비우고 {} 빈 노드로 초기화했습니다.`);
                        successCount++;

                    } else if (bType === 'COPY_NODE') {
                        if (!inputsMap.path || !inputsMap.property) throw new Error("원본 경로와 복사해 갈 경로를 모두 기입해 주세요.");
                        const currentData = await apiGet(inputsMap.path);
                        if (currentData === null) throw new Error(`원본 경로(/${inputsMap.path})에 복사할 데이터가 없습니다.`);
                        await apiPut(inputsMap.property, currentObjClone(currentData));
                        appendConsoleLog("response", `[성공] /${inputsMap.path}의 노드를 /${inputsMap.property} 경로로 안전하게 복사 완료.`);
                        successCount++;

                    // 연산 및 문자 처리
                    } else if (bType === 'MATH_ADD') {
                        const targetPath = inputsMap.path ? `${inputsMap.path}/${inputsMap.property}` : inputsMap.property;
                        const currentVal = await apiGet(targetPath);
                        const addValue = Number(inputsMap.value);
                        if (isNaN(addValue)) throw new Error("더할 수치는 반드시 올바른 숫자 유형이어야 합니다.");
                        const calcResult = (Number(currentVal) || 0) + addValue;
                        await apiPut(targetPath, calcResult);
                        appendConsoleLog("response", `[성공] /${targetPath} 값 더하기 완료: ${currentVal || 0} + ${addValue} = ${calcResult}`);
                        successCount++;

                    } else if (bType === 'MATH_SUB') {
                        const targetPath = inputsMap.path ? `${inputsMap.path}/${inputsMap.property}` : inputsMap.property;
                        const currentVal = await apiGet(targetPath);
                        const subValue = Number(inputsMap.value);
                        if (isNaN(subValue)) throw new Error("뺄 수치는 숫자 유형이어야 합니다.");
                        const calcResult = (Number(currentVal) || 0) - subValue;
                        await apiPut(targetPath, calcResult);
                        appendConsoleLog("response", `[성공] /${targetPath} 값 빼기 완료: ${currentVal || 0} - ${subValue} = ${calcResult}`);
                        successCount++;

                    } else if (bType === 'MATH_MUL') {
                        const targetPath = inputsMap.path ? `${inputsMap.path}/${inputsMap.property}` : inputsMap.property;
                        const currentVal = await apiGet(targetPath);
                        const mulValue = Number(inputsMap.value);
                        if (isNaN(mulValue)) throw new Error("곱할 수치는 숫자 유형이어야 합니다.");
                        const calcResult = (Number(currentVal) || 0) * mulValue;
                        await apiPut(targetPath, calcResult);
                        appendConsoleLog("response", `[성공] /${targetPath} 값 곱하기 완료: ${currentVal || 0} * ${mulValue} = ${calcResult}`);
                        successCount++;

                    } else if (bType === 'MATH_RANDOM') {
                        const min = Number(inputsMap.property) || 1;
                        const max = Number(inputsMap.value) || 100;
                        if (min > max) throw new Error("랜덤 최소값이 최대값보다 클 수 없습니다.");
                        const randomVal = Math.floor(Math.random() * (max - min + 1)) + min;
                        await apiPut(inputsMap.path || "system_config/random_value", randomVal);
                        appendConsoleLog("response", `[성공] 무작위 난수(${randomVal})를 생성하여 /${inputsMap.path || 'system_config/random_value'} 에 저장 완료.`);
                        successCount++;

                    } else if (bType === 'MATH_ROUND') {
                        if (!inputsMap.path) throw new Error("대상 소수 경로를 채워주세요.");
                        const currentVal = Number(await apiGet(inputsMap.path));
                        if (isNaN(currentVal)) throw new Error("해당 경로의 값이 숫자 포맷이 아닙니다.");
                        let calcResult;
                        if (inputsMap.property === '올림 (Ceil)') {
                            calcResult = Math.ceil(currentVal);
                        } else if (inputsMap.property === '내림 (Floor)') {
                            calcResult = Math.floor(currentVal);
                        } else {
                            calcResult = Math.round(currentVal);
                        }
                        await apiPut(inputsMap.path, calcResult);
                        appendConsoleLog("response", `[성공] /${inputsMap.path} 값을 ${inputsMap.property} 변환했습니다: ${currentVal} -> ${calcResult}`);
                        successCount++;

                    } else if (bType === 'TEXT_CONCAT') {
                        const targetPath = inputsMap.path ? `${inputsMap.path}/${inputsMap.property}` : inputsMap.property;
                        const currentText = await apiGet(targetPath);
                        const concatenated = (currentText ? String(currentText) : "") + inputsMap.value;
                        await apiPut(targetPath, concatenated);
                        appendConsoleLog("response", `[성공] /${targetPath} 텍스트 병합 완료 -> "${concatenated}"`);
                        successCount++;

                    } else if (bType === 'TEXT_REPLACE') {
                        const targetPath = inputsMap.path;
                        if (!targetPath) throw new Error("치환 대상 텍스트 경로를 지정하세요.");
                        const originalText = String(await apiGet(targetPath) || "");
                        const replaced = originalText.replace(new RegExp(inputsMap.property, 'g'), inputsMap.value);
                        await apiPut(targetPath, replaced);
                        appendConsoleLog("response", `[성공] /${targetPath} 문자 치환 완료 -> "${originalText}"을 "${replaced}"로 교체했습니다.`);
                        successCount++;

                    // 배열 및 JSON 조작
                    } else if (bType === 'ARRAY_PUSH') {
                        if (!inputsMap.path) throw new Error("배열 데이터 경로를 입력해 주세요.");
                        let currentArray = await apiGet(inputsMap.path);
                        if (!Array.isArray(currentArray)) {
                            currentArray = currentArray ? [currentArray] : [];
                        }
                        let addedValue = inputsMap.value;
                        if (!isNaN(addedValue) && addedValue !== "") addedValue = Number(addedValue);
                        currentArray.push(addedValue);
                        await apiPut(inputsMap.path, currentArray);
                        appendConsoleLog("response", `[성공] /${inputsMap.path} 배열에 원소 [${addedValue}]를 추가했습니다.`);
                        successCount++;

                    } else if (bType === 'ARRAY_POP') {
                        if (!inputsMap.path) throw new Error("배열 데이터 경로를 입력해 주세요.");
                        let currentArray = await apiGet(inputsMap.path);
                        if (!Array.isArray(currentArray) || currentArray.length === 0) {
                            throw new Error("대상 경로가 배열이 아니거나 비어있습니다.");
                        }
                        const popped = currentArray.pop();
                        await apiPut(inputsMap.path, currentArray);
                        appendConsoleLog("response", `[성공] /${inputsMap.path} 배열에서 마지막 원소 [${popped}]를 성공적으로 추출 제거했습니다.`);
                        successCount++;

                    // 파일 및 외부 웹 데이터 처리
                    } else if (bType === 'FILE_EXPORT') {
                        if (!inputsMap.path) throw new Error("내보낼 대상 데이터 경로가 지정되지 않았습니다.");
                        const expData = await apiGet(inputsMap.path);
                        if (expData === null) throw new Error("해당 경로의 데이터가 비어 있습니다.");
                        const blob = new Blob([JSON.stringify(expData, null, 4)], { type: "application/json" });
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = inputsMap.value || "backup.json";
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                        appendConsoleLog("response", `[성공] /${inputsMap.path} 하위 데이터를 로컬 파일 [${inputsMap.value || 'backup.json'}]로 즉시 다운로드 완료.`);
                        successCount++;

                    } else if (bType === 'WEB_API_GET') {
                        if (!inputsMap.value) throw new Error("요청할 외부 API URL이 공백입니다.");
                        const apiRes = await fetch(inputsMap.value);
                        if (!apiRes.ok) throw new Error(`네트워크 오류 발생 (상태: ${apiRes.status})`);
                        const apiJson = await apiRes.json();
                        const targetPath = inputsMap.path || "system_config/external_api";
                        await apiPut(targetPath, apiJson);
                        appendConsoleLog("response", `[성공] 외부 API 호출 데이터를 받아서 /${targetPath} 경로에 덮어썼습니다.`);
                        successCount++;

                    // 유틸리티 및 알림
                    } else if (bType === 'CONSOLE_LOG') {
                        appendConsoleLog("response", `💬 사용자 로그 메세지: "${inputsMap.value || '비어 있는 로그'}"`);
                        successCount++;

                    } else if (bType === 'PLAY_BUZZER') {
                        playSynthSound(inputsMap.value);
                        appendConsoleLog("response", `🔊 피치 효과음 재생 성공: [${inputsMap.value}]`);
                        successCount++;

                    } else if (bType === 'SPEECH_SAY') {
                        if (!inputsMap.value) throw new Error("말할 내용이 비어있습니다.");
                        playWebSpeechTTS(inputsMap.value);
                        appendConsoleLog("response", `🗣 컴퓨터 TTS 한국어 음성 출력 완료: "${inputsMap.value}"`);
                        successCount++;

                    } else if (bType === 'VIRTUAL_ALERT') {
                        Swal.fire({
                            title: inputsMap.property || "알림",
                            text: inputsMap.value || "메시지가 비어있습니다.",
                            icon: "info",
                            confirmButtonColor: "#2563eb"
                        });
                        appendConsoleLog("response", `💬 화면에 가상 알림 상자 팝업 실행 완료.`);
                        successCount++;

                    } else if (bType === 'BROWSER_COPY') {
                        if (!inputsMap.path) throw new Error("복사 타겟 경로가 지정되지 않았습니다.");
                        const targetVal = await apiGet(inputsMap.path);
                        if (targetVal === null) throw new Error("복사할 데이터 대상이 존재하지 않습니다 (null).");
                        const finalCopyStr = typeof targetVal === 'object' ? JSON.stringify(targetVal, null, 2) : String(targetVal);
                        
                        const tempInput = document.createElement("textarea");
                        tempInput.value = finalCopyStr;
                        document.body.appendChild(tempInput);
                        tempInput.select();
                        document.execCommand('copy');
                        document.body.removeChild(tempInput);
                        appendConsoleLog("response", `[성공] /${inputsMap.path} 데이터를 문자열로 가공하여 클립보드에 카피했습니다.`);
                        successCount++;

                    } else if (bType === 'DELAY_WAIT') {
                        const seconds = Number(inputsMap.value) || 1;
                        appendConsoleLog("system", `⏳ ${seconds}초 동안 대기 연산을 수행합니다...`);
                        await new Promise(resolve => setTimeout(resolve, seconds * 1000));
                        appendConsoleLog("response", `⌛ ${seconds}초 대기 완료. 다음 블록을 실행합니다.`);
                        successCount++;
                    }

                } catch (err) {
                    console.error(err);
                    appendConsoleLog("error", `❌ [블록 ${i + 1} 실행 실패] -> ${err.message}`);
                    failCount++;
                }

                if (blockDOM) blockDOM.classList.remove('block-running');
            }

            appendConsoleLog("compile", `■ 컴파일러 순회 완료 (성공: ${successCount}건, 실패: ${failCount}건)`);
        }

        function playSynthSound(pitchType) {
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();

                oscillator.type = 'sine';
                
                let frequency = 440;
                if (pitchType === '높음 (High)') {
                    frequency = 880;
                } else if (pitchType === '낮음 (Low)') {
                    frequency = 220;
                }

                oscillator.frequency.setValueAtTime(frequency, audioCtx.currentTime);
                gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.35);

                oscillator.connect(gainNode);
                gainNode.connect(audioCtx.destination);

                oscillator.start();
                oscillator.stop(audioCtx.currentTime + 0.4);
            } catch (e) {
                console.warn("효과음 재생 에러:", e);
            }
        }

        function playWebSpeechTTS(message) {
            try {
                if ('speechSynthesis' in window) {
                    window.speechSynthesis.cancel();
                    
                    const utterance = new SpeechSynthesisUtterance(message);
                    utterance.lang = 'ko-KR';
                    utterance.pitch = 1.0;
                    utterance.rate = 1.0;
                    
                    window.speechSynthesis.speak(utterance);
                } else {
                    console.warn("이 브라우저는 음성 합성(SpeechSynthesis) 기능을 지원하지 않습니다.");
                }
            } catch (e) {
                console.error("음성 합성 TTS 도중 예외:", e);
            }
        }

        function currentObjClone(obj) {
            return JSON.parse(JSON.stringify(obj));
        }

        function appendConsoleLog(type, message) {
            const container = document.getElementById('console-logs');
            const now = new Date();
            const timeStr = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}:${now.getSeconds().toString().padStart(2, '0')}`;

            const row = document.createElement('div');
            row.className = "py-0.5 border-b border-slate-850 flex items-start gap-2 text-[11px] leading-relaxed";

            let typeBadge = "[SYS]";
            let typeColor = "text-slate-400";

            if (type === 'auth') {
                typeBadge = "[AUTH]";
                typeColor = "text-blue-400 font-extrabold";
            } else if (type === 'compile') {
                typeBadge = "[BLOCK]";
                typeColor = "text-indigo-400 font-extrabold";
            } else if (type === 'response') {
                typeBadge = "[DONE]";
                typeColor = "text-emerald-400 font-extrabold";
            } else if (type === 'error') {
                typeBadge = "[FAIL]";
                typeColor = "text-rose-500 font-extrabold animate-pulse";
            }

            row.innerHTML = `
                <span class="text-slate-650 font-mono shrink-0 select-none">${timeStr}</span>
                <span class="${typeColor} shrink-0">${typeBadge}</span>
                <span class="text-slate-350 break-all select-text">${message}</span>
            `;

            container.appendChild(row);
            container.scrollTop = container.scrollHeight;
        }

        function clearConsole() {
            document.getElementById('console-logs').innerHTML = `<p class="text-slate-500">// 실시간 로그가 여기에 출력됩니다.</p>`;
        }

        function downloadJsonBackup() {
            let dataToDownload = {};
            if (currentDbUrl.startsWith("local://")) {
                dataToDownload = getLocalDbObject();
            } else {
                const previewText = document.getElementById('db-json-preview').innerText;
                try {
                    dataToDownload = JSON.parse(previewText);
                } catch (e) {
                    showToast('백업 실패', '유효한 JSON 로드 대기 중입니다.', 'error');
                    return;
                }
            }

            const blob = new Blob([JSON.stringify(dataToDownload, null, 4)], { type: "application/json" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `pal_block_backup_${new Date().toISOString().split('T')[0]}.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            
            showToast('백업 완료', '데이터베이스가 JSON 파일로 컴퓨터에 다운로드되었습니다.', 'success');
        }

        function showToast(title, text, icon) {
            const Toast = Swal.mixin({
                toast: true,
                position: 'bottom-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true
            });
            Toast.fire({ icon: icon, title: title, text: text });
        }

        window.onload = function () {
            lucide.createIcons();
            renderBlockPalette();
            renderWorkspaceCanvas();
        }
    </script>
