        async function apiGet(path) {
            if (currentDbUrl.startsWith("local://")) {
                const dbObj = getLocalDbObject();
                return getValueByPath(dbObj, path);
            }

            const formatted = formatPath(path);
            const targetUrl = `${currentDbUrl}${formatted}.json` + (currentDbSecret ? `?auth=${currentDbSecret}` : '');
            
            const res = await fetch(targetUrl);
            if (!res.ok) throw new Error(`GET 에러: ${res.status}`);
            return await res.json();
        }

        async function apiPut(path, value) {
            // Base64 긴 이미지의 경우 출력을 조금 요약해서 나타냄
            const displayVal = (typeof value === 'string' && value.startsWith('data:image')) ? 'Base64 이미지 데이터' : (typeof value === 'object' ? JSON.stringify(value) : value);
            appendConsoleLog("system", `[DB 요청] PUT -> 경로: /${path} | 값: ${displayVal}`);

            if (currentDbUrl.startsWith("local://")) {
                let dbObj = getLocalDbObject();
                dbObj = setValueByPath(dbObj, path, value);
                saveLocalDbObject(dbObj);
                syncDatabasePreview();
                return value;
            }

            const formatted = formatPath(path);
            const targetUrl = `${currentDbUrl}${formatted}.json` + (currentDbSecret ? `?auth=${currentDbSecret}` : '');
            
            const res = await fetch(targetUrl, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(value)
            });
            if (!res.ok) throw new Error(`PUT 에러: ${res.status}`);
            syncDatabasePreview();
            return await res.json();
        }

        async function apiPush(path, value) {
            appendConsoleLog("system", `[DB 요청] PUSH -> 경로: /${path} | 값: ${value}`);

            if (currentDbUrl.startsWith("local://")) {
                const randomId = "push-id-" + Math.random().toString(36).substring(2, 8);
                let dbObj = getLocalDbObject();
                
                let currentList = getValueByPath(dbObj, path);
                if (currentList === null || typeof currentList !== 'object') {
                    currentList = {};
                }
                currentList[randomId] = value;
                
                dbObj = setValueByPath(dbObj, path, currentList);
                saveLocalDbObject(dbObj);
                syncDatabasePreview();
                return randomId;
            }

            const formatted = formatPath(path);
            const targetUrl = `${currentDbUrl}${formatted}.json` + (currentDbSecret ? `?auth=${currentDbSecret}` : '');
            
            const res = await fetch(targetUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(value)
            });
            if (!res.ok) throw new Error(`PUSH 에러: ${res.status}`);
            const data = await res.json();
            syncDatabasePreview();
            return data.name;
        }

        async function apiDelete(path) {
            appendConsoleLog("system", `[DB 요청] DELETE -> 경로: /${path}`);

            if (currentDbUrl.startsWith("local://")) {
                let dbObj = getLocalDbObject();
                dbObj = deleteValueByPath(dbObj, path);
                saveLocalDbObject(dbObj);
                syncDatabasePreview();
                return true;
            }

            const formatted = formatPath(path);
            const targetUrl = `${currentDbUrl}${formatted}.json` + (currentDbSecret ? `?auth=${currentDbSecret}` : '');
            
            const res = await fetch(targetUrl, { method: 'DELETE' });
            if (!res.ok) throw new Error(`DELETE 에러: ${res.status}`);
            syncDatabasePreview();
            return true;
        }

        function formatPath(path) {
            let p = path.trim();
            if (p.startsWith("/")) p = p.substring(1);
            if (p.endsWith("/")) p = p.substring(0, p.length - 1);
            return p;
        }

        async function syncDatabasePreview() {
            const preview = document.getElementById('db-json-preview');
            const syncBadge = document.getElementById('sync-badge');
            const dbUrlLabel = document.getElementById('active-db-url');

            dbUrlLabel.innerText = currentDbUrl;

            let fullDbData = null;

            if (currentDbUrl.startsWith("local://")) {
                syncBadge.className = "inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-100";
                syncBadge.innerHTML = `<span class="w-1.5 h-1.5 bg-amber-500 rounded-full animate-pulse"></span> 로컬 시뮬레이터`;
                
                fullDbData = getLocalDbObject();
                preview.innerText = JSON.stringify(fullDbData, null, 4);
            } else {
                syncBadge.className = "inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-blue-600 border border-blue-100";
                syncBadge.innerHTML = `<span class="w-1.5 h-1.5 bg-blue-500 rounded-full animate-pulse"></span> 온라인 연동 중`;

                try {
                    fullDbData = await apiGet("/");
                    if (fullDbData === null) {
                        preview.innerText = "// 데이터베이스가 완전히 비어있습니다.";
                    } else {
                        preview.innerText = JSON.stringify(fullDbData, null, 4);
                    }
                } catch (err) {
                    preview.innerText = `// 데이터 로드 실패: ${err.message}`;
                }
            }

            // [AI 이미지 갤러리 프리뷰 실시간 스캔 기능]
            const imagesFound = [];
            function scanForImages(obj, path = "") {
                if (!obj) return;
                if (typeof obj === 'string') {
                    if (obj.startsWith('data:image/') || (obj.startsWith('http') && (obj.match(/\.(jpeg|jpg|gif|png|webp)/i) || obj.includes('placehold.co')))) {
                        imagesFound.push({ path, url: obj });
                    }
                } else if (typeof obj === 'object') {
                    Object.entries(obj).forEach(([key, val]) => {
                        scanForImages(val, path ? `${path}/${key}` : key);
                    });
                }
            }
            if (fullDbData) {
                scanForImages(fullDbData);
            }

            const gallery = document.getElementById('image-gallery-container');
            const grid = document.getElementById('image-gallery-grid');
            if (imagesFound.length > 0) {
                gallery.classList.remove('hidden');
                grid.innerHTML = "";
                imagesFound.forEach(img => {
                    const card = document.createElement('div');
                    card.className = "bg-white border border-slate-200 rounded-xl p-1 shadow-xs flex flex-col";
                    card.innerHTML = `
                        <img src="${img.url}" class="w-full h-24 object-cover rounded-lg" onerror="this.src='https://placehold.co/150?text=Image+Load+Error'" />
                        <span class="text-[9px] text-slate-500 font-mono mt-1 px-1 truncate" title="${img.path}">${img.path}</span>
                    `;
                    grid.appendChild(card);
                });
            } else {
                gallery.classList.add('hidden');
            }
        }

