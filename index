        async function callGeminiAPI(userQuery) {
            const apiKey = ""; // Canvas 런타임에서 자동 주입됨
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

            const systemPrompt = `
                당신은 파이어베이스 및 구글 Gemini API 연동 최고 전문가입니다.
                사용자에게 Javascript 및 Web 환경에서 바로 복사하여 사용할 수 있는 완벽한 최신 코드를 한글로 제공해 주세요.
                다음 규칙을 철저히 따라 소스코드를 서술하세요:
                1. API Key 변수는 반드시 \`const apiKey = "";\` 로 비워두어 런타임 보안 구조를 따릅니다.
                2. 텍스트는 \`gemini-3-flash-preview\` 모델을, 이미지는 \`imagen-4.0-generate-001\`을 기준으로 합니다.
                3. 마크다운의 \`\`\`javascript ... \`\`\` 형태로 코드를 감싸주어 유저가 복사하기 쉽게 하세요.
            `;

            const payload = {
                contents: [{ parts: [{ text: userQuery }] }],
                systemInstruction: {
                    parts: [{ text: systemPrompt }]
                }
            };

            const response = await fetch(apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                throw new Error(`API 응답 실패 (상태: ${response.status})`);
            }

            const result = await response.json();
            return result.candidates?.[0]?.content?.parts?.[0]?.text || "답변 분석 실패";
        }

        function formatMarkdownToHtml(mdText) {
            let html = mdText
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;");

            const codeBlockRegex = /```(?:javascript|js)?([\s\S]*?)```/g;
            html = html.replace(codeBlockRegex, (match, code) => {
                const escapedCode = code.trim();
                const codeId = "code_" + Math.random().toString(36).substring(2, 9);
                return `
                    <div class="relative bg-slate-900 text-slate-100 rounded-xl p-3 my-2 font-mono text-[10px]">
                        <button onclick="copyToClipboardFromAI('${codeId}')" class="absolute right-2 top-2 px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold rounded hover:text-white transition-all">복사</button>
                        <textarea id="${codeId}" class="hidden">${escapedCode}</textarea>
                        <pre class="overflow-x-auto whitespace-pre-wrap leading-relaxed">${escapedCode}</pre>
                    </div>
                `;
            });

            html = html.replace(/`([^`]+)`/g, '<code class="bg-indigo-50 text-indigo-700 px-1 py-0.5 rounded font-mono font-bold">$1</code>');
            html = html.replace(/###\s+(.*)/g, '<h5 class="text-xs font-black text-slate-800 mt-3 mb-1.5 flex items-center gap-1"><span class="w-1.5 h-1.5 bg-indigo-500 rounded-full"></span> $1</h5>');
            html = html.replace(/\n/g, '<br>');

            return `<div class="space-y-1 font-medium text-slate-700">${html}</div>`;
        }

